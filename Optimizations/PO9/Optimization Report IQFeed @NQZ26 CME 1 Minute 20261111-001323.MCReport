/* This function maximizes the ratio of gross profit to gross loss. The smaller the gross loss is and the higher the gross profit is the higher this ratio will be. */

/************************************* Sample 4 ******************************************/
// if (StrategyPerformance.TotalTrades != 0) {
//    return StrategyPerformance.WinningTrades / StrategyPerformance.TotalTrades;
// }
/* This function maximizes the percent of profitable trades. */


/*

The reserved words supported in Multicharts optimization:
* NetProfit
* GrossProfit
* GrossLoss
* TotalTrades
* PercentProfitable
* WinningTrades
* LosingTrades
* AvgTrade
* AvgWinningTrade
