//    return StrategyPerformance.GrossProfit / StrategyPerformance.GrossLoss;
// }
/* This function maximizes the ratio of gross profit to gross loss. The smaller the gross loss is and the higher the gross profit is the higher this ratio will be. */

/************************************* Sample 4 ******************************************/
